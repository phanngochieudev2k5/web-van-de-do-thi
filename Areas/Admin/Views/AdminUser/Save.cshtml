@model WebDoThi.Models.TblUser

@{
    bool isAddMode = Model.Id == 0;
    ViewData["Title"] = isAddMode ? "Thêm tài khoản mới" : "Cập nhật tài khoản";
}

<style>
    .admin-form-wrapper {
        max-width: 650px;
        margin: 2rem auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        border: 1px solid #e2e8f0;
        padding: 2.5rem 3rem;
    }

    .admin-page-title {
        color: #0f172a;
        font-weight: 700;
        font-size: 1.4rem;
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
        border-bottom: 2px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .custom-label {
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
        display: block;
    }

    .custom-input {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        color: #1e293b;
        transition: all 0.2s ease;
        background-color: #f8fafc;
        width: 100%;
    }

        .custom-input:focus {
            background-color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59,130,246,0.15);
            outline: none;
        }

        .custom-input[readonly] {
            background-color: #f1f5f9;
            color: #94a3b8;
            cursor: not-allowed;
        }

    .btn-save {
        background-color: #2563eb;
        border: none;
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        border-radius: 8px;
        color: white;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

        .btn-save:hover {
            background-color: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37,99,235,0.25);
        }

    .btn-cancel {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-cancel:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }

    .required-asterisk {
        color: #ef4444;
        margin-left: 3px;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }
</style>

<div class="container-fluid">
    <div class="admin-form-wrapper">
        <h3 class="admin-page-title">
            @if (isAddMode)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#2563eb" viewBox="0 0 16 16">
                    <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                    <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5z" />
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#f59e0b" viewBox="0 0 16 16">
                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                </svg>
            }
            @ViewData["Title"]
        </h3>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="border-radius: 8px; border: none; background-color: #fef2f2; color: #991b1b; padding: 1rem;">
                @TempData["Error"]
            </div>
        }

        <form action="@Url.Action("Save", "AdminUser")" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group-custom">
                <label class="custom-label">Họ và Tên<span class="required-asterisk">*</span></label>
                <input type="text" class="custom-input" name="FullName" value="@Model.FullName" placeholder="Nhập họ tên đầy đủ" required />
            </div>

            <div class="form-group-custom">
                <label class="custom-label">Email đăng nhập<span class="required-asterisk">*</span></label>
                <input type="email" class="custom-input" name="Email" value="@Model.Email" placeholder="ví dụ: admin@smartcitizen.vn" required @(isAddMode ? "" : "readonly") />
            </div>

            <div class="form-group-custom">
                <label class="custom-label">Mật khẩu</label>
                <input type="password" class="custom-input" name="newPassword" placeholder="@(isAddMode ? "Nhập mật khẩu (Mặc định: 123456)" : "Bỏ trống nếu không muốn đổi mật khẩu")" />
            </div>

            <div class="form-group-custom">
                <label class="custom-label">Phân quyền (Role)<span class="required-asterisk">*</span></label>
                <select name="RoleId" class="custom-input" required>
                    @foreach (var role in ViewBag.Roles as List<WebDoThi.Models.TblRole>)
                    {
                        if (Model.RoleId == role.Id)
                        {
                            <option value="@role.Id" selected>@role.Name - @role.Description</option>
                        }
                        else
                        {
                            <option value="@role.Id">@role.Name - @role.Description</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group-custom">
                <label class="custom-label">Điểm uy tín</label>
                <input type="number" class="custom-input" name="TrustPoints" value="@Model.TrustPoints" />
            </div>

            <div class="d-flex gap-3 mt-5 pt-4" style="border-top: 1px solid #e2e8f0;">
                <button type="submit" class="btn-save">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z" />
                    </svg>
                    @(isAddMode ? "Lưu tài khoản" : "Cập nhật thay đổi")
                </button>

                <a href="@Url.Action("Index", "AdminUser")" class="btn-cancel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8zm15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-4.5-.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5z" />
                    </svg>
                    Hủy & Quay lại
                </a>
            </div>
        </form>
    </div>
</div>