@{
    ViewData["Title"] = "Đăng bài viết mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div style="padding: 24px; margin-top: 10px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <div style="max-width: 800px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="margin: 0; font-size: 1.6rem; font-weight: 700; color: #1e293b;">
            ✍️ Soạn bài viết mới
        </h2>
        <a href="/Admin/News" style="background-color: #f8fafc; color: #475569; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.95rem; border: 1px solid #cbd5e1; transition: 0.2s;">
            ← Quay lại
        </a>
    </div>

    <div style="max-width: 800px; margin: 0 auto; background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; padding: 32px;">

        <form action="/Admin/News/Create" method="post" enctype="multipart/form-data">

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-weight: 600; color: #0f172a; margin-bottom: 8px;">
                    Tiêu đề bài viết <span style="color: #ef4444;">*</span>
                </label>
                <input type="text" name="Title" placeholder="Nhập tiêu đề thông báo, luật lệ..." required
                       style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; box-sizing: border-box; outline: none; transition: border-color 0.2s;" />
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-weight: 600; color: #0f172a; margin-bottom: 8px;">
                    Hình ảnh đính kèm (Tùy chọn)
                </label>
                <input type="file" name="ImageFile" accept="image/*"
                       style="width: 100%; padding: 10px 16px; border: 1px dashed #94a3b8; border-radius: 8px; font-size: 0.95rem; color: #475569; box-sizing: border-box; background: #f8fafc; cursor: pointer;" />
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-weight: 600; color: #0f172a; margin-bottom: 8px;">
                    Nội dung chi tiết <span style="color: #ef4444;">*</span>
                </label>
                <textarea name="Content" rows="10" placeholder="Nhập nội dung bài viết..." required
                          style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; box-sizing: border-box; outline: none; resize: vertical; min-height: 200px; line-height: 1.5;"></textarea>
                <small style="color: #64748b; margin-top: 8px; display: block; font-size: 0.85rem;">
                    💡 Mẹo: Các đoạn xuống dòng sẽ tự động được giữ nguyên khi hiển thị cho người dân.
                </small>
            </div>

            <div style="text-align: right; margin-top: 32px;">
                <button type="submit" style="background: #2563eb; color: white; padding: 14px 32px; font-size: 1.05rem; font-weight: 700; border-radius: 8px; border: none; cursor: pointer; box-shadow: 0 4px 6px -1px rgba(37,99,235,0.2); transition: 0.2s;">
                    🚀 Xuất bản bài viết
                </button>
            </div>

        </form>
    </div>
</div>