@model IEnumerable<WebDoThi.Models.TblNews>
@{
    ViewData["Title"] = "Quản lý Tin tức";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div style="padding: 24px; margin-top: 10px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="margin: 0; font-size: 1.6rem; font-weight: 700; color: #1e293b;">
            📰 Quản lý Tin tức & Thông báo
        </h2>
        <a href="/Admin/News/Create" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.95rem; box-shadow: 0 4px 6px -1px rgba(37,99,235,0.2); transition: 0.2s;">
            + Đăng bài mới
        </a>
    </div>

    <div style="background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; overflow: hidden;">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 800px;">
                <thead>
                    <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <th style="padding: 16px 20px; color: #64748b; font-weight: 600; font-size: 0.9rem; text-transform: uppercase;">ID</th>
                        <th style="padding: 16px 20px; color: #64748b; font-weight: 600; font-size: 0.9rem; text-transform: uppercase;">Hình ảnh</th>
                        <th style="padding: 16px 20px; color: #64748b; font-weight: 600; font-size: 0.9rem; text-transform: uppercase;">Tiêu đề</th>
                        <th style="padding: 16px 20px; color: #64748b; font-weight: 600; font-size: 0.9rem; text-transform: uppercase;">Ngày đăng</th>
                        <th style="padding: 16px 20px; color: #64748b; font-weight: 600; font-size: 0.9rem; text-transform: uppercase;">Tương tác</th>
                        <th style="padding: 16px 20px; color: #64748b; font-weight: 600; font-size: 0.9rem; text-transform: uppercase; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 16px 20px; color: #0f172a; font-weight: 500;">#@item.Id</td>
                                <td style="padding: 16px 20px;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" style="width: 120px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid #e2e8f0;" />
                                    }
                                    else
                                    {
                                        <div style="width: 120px; height: 70px; background: #f1f5f9; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 0.85rem;">
                                            Không có ảnh
                                        </div>
                                    }
                                </td>
                                <td style="padding: 16px 20px; color: #0f172a; font-weight: 600; font-size: 1.05rem;">
                                    <div style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @item.Title
                                    </div>
                                </td>
                                <td style="padding: 16px 20px; color: #475569; font-size: 0.95rem;">
                                    @item.CreatedAt?.ToString("dd/MM/yyyy") <br>
                                    <small style="color: #94a3b8;">@item.CreatedAt?.ToString("HH:mm")</small>
                                </td>
                                <td style="padding: 16px 20px;">
                                    <div style="display: flex; gap: 8px;">
                                        <span style="background: #fee2e2; color: #ef4444; padding: 4px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: 700;">
                                            ❤️ @(item.LikesCount ?? 0)
                                        </span>
                                        <span style="background: #e0e7ff; color: #4f46e5; padding: 4px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: 700;">
                                            💬 @(item.CommentsCount ?? 0)
                                        </span>
                                    </div>
                                </td>
                                <td style="padding: 16px 20px; text-align: center;">
                                    <form action="/Admin/News/Delete" method="post" onsubmit="return confirm('⚠️ Chú ý: Bạn có chắc chắn muốn xóa bài viết này không? Không thể khôi phục sau khi xóa!');" style="margin: 0;">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" style="background: white; color: #ef4444; border: 1px solid #fca5a5; padding: 6px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: 0.2s;">
                                            🗑 Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="padding: 40px; text-align: center; color: #64748b;">
                                📭 Chưa có bài viết thông báo nào được đăng.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>