@model WebDoThi.Models.TblFundCampaign
@{
    ViewData["Title"] = Model.Title;
    double percent = Model.TargetAmount > 0 ? (double)((Model.CurrentAmount ?? 0) / Model.TargetAmount) * 100 : 0;
    if (percent > 100) percent = 100;
}

<div class="container py-5" style="max-width: 900px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <a href="/Fund" style="color: #64748b; text-decoration: none; font-weight: 600;">← Quay lại danh sách</a>

    <div class="row mt-4">
        <div class="col-md-7">
            <h2 style="font-weight: 800; color: #1e293b; margin-bottom: 20px;">@Model.Title</h2>
            <div style="color: #475569; font-size: 0.95rem; margin-bottom: 24px;">
                📅 Thời gian: @Model.StartDate?.ToString("dd/MM/yyyy") - <strong style="color: #ef4444;">@Model.EndDate?.ToString("dd/MM/yyyy")</strong>
            </div>

            <div style="background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; line-height: 1.6; color: #334155; white-space: pre-line;">
                @Model.Description
            </div>
        </div>

        <div class="col-md-5 mt-4 mt-md-0">
            <div style="background: white; padding: 24px; border-radius: 16px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); border: 1px solid #e2e8f0;">

                <h4 style="font-weight: 700; color: #0f172a; margin-bottom: 16px;">Tiến độ quyên góp</h4>
                <div style="font-size: 2rem; font-weight: 800; color: #10b981;">@String.Format("{0:N0}", Model.CurrentAmount) đ</div>
                <div style="color: #64748b; font-size: 0.95rem; margin-bottom: 12px;">Đạt @percent.ToString("0.0")% của mục tiêu @String.Format("{0:N0}", Model.TargetAmount) đ</div>

                <div style="width: 100%; background-color: #f1f5f9; border-radius: 10px; height: 12px; overflow: hidden; margin-bottom: 30px;">
                    <div style="width: @percent.ToString("0.0").Replace(",",".")%; background-color: #10b981; height: 100%; border-radius: 10px;"></div>
                </div>

                <hr style="border-color: #e2e8f0; margin-bottom: 24px;" />

                @if (User.Identity.IsAuthenticated)
                {
                    <form action="/Fund/CreatePayment" method="post">
                        <input type="hidden" name="campaignId" value="@Model.Id" />

                        <div style="margin-bottom: 16px;">
                            <label style="font-weight: 600; color: #0f172a; margin-bottom: 8px; display: block;">Nhập số tiền muốn ủng hộ (VNĐ)</label>
                            <input type="number" name="amount" required min="10000" step="10000" placeholder="Tối thiểu 10,000 đ"
                                   style="width: 100%; padding: 12px 16px; border: 2px solid #cbd5e1; border-radius: 8px; font-size: 1.1rem; font-weight: 600;" />
                        </div>

                        <div style="margin-bottom: 24px;">
                            <label style="font-weight: 600; color: #0f172a; margin-bottom: 8px; display: block;">Lời nhắn (Không dấu)</label>
                            <input type="text" name="message" placeholder="VD: Nguyen Van A ung ho"
                                   style="width: 100%; padding: 10px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem;" />
                        </div>

                        <button type="submit" style="width: 100%; background: #005baa; color: white; border: none; padding: 14px; border-radius: 8px; font-size: 1.1rem; font-weight: 700; display: flex; justify-content: center; align-items: center; gap: 10px; cursor: pointer; transition: 0.2s;">
                            💳 Thanh toán qua VNPAY
                        </button>
                    </form>
                }
                else
                {
                    <div style="text-align: center; padding: 30px 20px; background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1;">
                        <div style="font-size: 2.5rem; margin-bottom: 10px;">🔒</div>
                        <h5 style="color: #475569; font-weight: 600; margin-bottom: 16px; line-height: 1.5;">Vui lòng đăng nhập hệ thống để thực hiện quyên góp</h5>
                        <a href="/Account/Login" style="background: #2563eb; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 700; display: inline-block; box-shadow: 0 4px 6px -1px rgba(37,99,235,0.2);">
                            Đăng nhập ngay
                        </a>
                    </div>
                }

            </div>
        </div>
    </div>
</div>