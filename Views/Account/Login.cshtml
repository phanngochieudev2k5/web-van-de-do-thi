@{
    ViewData["Title"] = "Đăng nhập";
}

<div style="max-width: 400px; margin: 80px auto; background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">
    <h2 style="text-align: center; margin-bottom: 24px; font-weight: 800; color: #0f172a;">Đăng nhập</h2>

    @if (ViewBag.Error != null)
    {
        <div style="background: #fee2e2; color: #ef4444; padding: 12px; border-radius: 8px; margin-bottom: 20px; text-align: center; font-weight: 500;">
            @ViewBag.Error
        </div>
    }

    <form asp-action="Login" asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]" method="post">
        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Địa chỉ Email</label>
            <input type="email" name="email" required style="width: 100%; padding: 12px 16px; border: 2px solid #e2e8f0; border-radius: 8px; outline: none;" />
        </div>

        <div style="margin-bottom: 24px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Mật khẩu</label>
            <input type="password" name="password" required style="width: 100%; padding: 12px 16px; border: 2px solid #e2e8f0; border-radius: 8px; outline: none;" />
        </div>

        <button type="submit" style="width: 100%; padding: 14px; background: #2563eb; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 1.05rem; cursor: pointer;">Đăng nhập ngay</button>
    </form>

    <div style="text-align: center; margin-top: 24px; color: #64748b;">
        Chưa có tài khoản? <a href="/Account/Register" style="color: #2563eb; font-weight: 600; text-decoration: none;">Đăng ký</a>
    </div>
</div>