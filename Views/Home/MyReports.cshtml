@model IEnumerable<WebDoThi.Models.TblReport>
@{
    ViewData["Title"] = "Báo cáo của tôi";
    var categories = ViewBag.Categories as IEnumerable<dynamic>;
}

<style>
    body {
        background: #f8fafc;
    }

    .layout-wrapper {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 32px;
        padding: 40px 0;
        align-items: start;
    }
    .filter-panel {
        background: white;
        padding: 24px;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        position: sticky;
        top: 24px;
    }

    .filter-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 20px;
        text-transform: uppercase;
    }

    .filter-group {
        margin-bottom: 20px;
    }

        .filter-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 8px;
        }

    .filter-input {
        width: 100%;
        padding: 12px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        font-size: 0.95rem;
        transition: 0.2s;
    }

        .filter-input:focus {
            border-color: #3b82f6;
        }

    .btn-filter {
        width: 100%;
        padding: 14px;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-filter:hover {
            background: #2563eb;
        }

    .btn-reset {
        display: block;
        text-align: center;
        margin-top: 12px;
        color: #64748b;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
    }

    .report-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border: 1px solid #f1f5f9;
    }

        .report-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
            border-color: #cbd5e1;
        }

    .card-img {
        height: 160px;
        width: 100%;
        object-fit: cover;
        background: #e2e8f0;
    }

    .card-body {
        padding: 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .card-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 8px;
    }

    .card-cat {
        background: #f1f5f9;
        padding: 4px 10px;
        border-radius: 20px;
        color: #475569;
    }

    .card-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 12px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-address {
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 24px;
    }

    .tracker-container {
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px dashed #e2e8f0;
    }

    .progress-track {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-bottom: 8px;
    }

        .progress-track::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 10px;
            right: 10px;
            height: 3px;
            background: #e2e8f0;
            transform: translateY(-50%);
            z-index: 1;
        }

    .step-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #e2e8f0;
        border: 3px solid white;
        position: relative;
        z-index: 2;
    }

        .step-dot.active {
            background: #3b82f6;
        }

        .step-dot.resolved {
            background: #10b981;
        }

        .step-dot.rejected {
            background: #ef4444;
        }

    .step-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        font-weight: 700;
        color: #94a3b8;
    }

    .label-active {
        color: #3b82f6;
    }

    .label-resolved {
        color: #10b981;
    }

    .label-rejected {
        color: #ef4444;
    }

    @@media (max-width: 900px) {
        .layout-wrapper {
            grid-template-columns: 1fr;
        }

        .filter-panel {
            position: static;
            margin-bottom: 24px;
        }
    }
</style>

<div class="container layout-wrapper">
    <div class="filter-panel">
        <h2 class="filter-title">Lọc báo cáo</h2>
        <form method="get" action="/Home/MyReports">
            <div class="filter-group">
                <label>Trạng thái xử lý</label>
                <select name="status" class="filter-input">
                    <option value="">Tất cả trạng thái</option>
                    <option value="PENDING" selected="@(ViewBag.CurrentStatus == "PENDING")">Chờ duyệt</option>
                    <option value="IN_PROGRESS" selected="@(ViewBag.CurrentStatus == "IN_PROGRESS")">Đang xử lý</option>
                    <option value="RESOLVED" selected="@(ViewBag.CurrentStatus == "RESOLVED")">Đã hoàn thành</option>
                    <option value="REJECTED" selected="@(ViewBag.CurrentStatus == "REJECTED")">Bị từ chối</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Lĩnh vực / Danh mục</label>
                <select name="categoryId" class="filter-input">
                    <option value="">Tất cả lĩnh vực</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(ViewBag.CurrentCategory == cat.Id)">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>Ngày gửi (Ngày/Tháng/Năm)</label>
                <input type="date" name="dateFilter" class="filter-input" value="@ViewBag.CurrentDate" />
            </div>

            <button type="submit" class="btn-filter">Áp dụng bộ lọc</button>
            <a href="/Home/MyReports" class="btn-reset">↺ Xóa bộ lọc</a>
        </form>
    </div>

    <div>
        <h2 style="font-size: 1.6rem; font-weight: 800; margin-bottom: 24px; color: #0f172a;">Lịch sử gửi phản ánh (@Model.Count())</h2>

        @if (!Model.Any())
        {
            <div style="background: white; padding: 40px; text-align: center; border-radius: 16px; color: #64748b; font-weight: 600;">
                <div style="font-size: 3rem; margin-bottom: 16px;">📂</div>
                Chưa tìm thấy báo cáo nào phù hợp với bộ lọc.
            </div>
        }
        else
        {
            <div class="cards-grid">
                @foreach (var item in Model)
                {
                    bool isPending = item.Status == "PENDING";
                    bool isProgress = item.Status == "IN_PROGRESS";
                    bool isResolved = item.Status == "RESOLVED";
                    bool isRejected = item.Status == "REJECTED";

                    <a href="/Home/Details/@item.Id" class="report-card">
                        @if (item.TblReportImages != null && item.TblReportImages.Any())
                        {
                            <img src="@item.TblReportImages.First().ImageUrl" class="card-img" />
                        }
                        else
                        {
                            <div class="card-img" style="display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #94a3b8;">📷</div>
                        }

                        <div class="card-body">
                            <div class="card-meta">
                                <span>📅 @item.CreatedAt?.ToString("dd/MM/yyyy")</span>
                                <span class="card-cat">@item.Category?.Name</span>
                            </div>
                            <div class="card-title">@item.Title</div>
                            <div class="card-address">📍 @item.Address</div>

                            <div class="tracker-container">
                                @if (isRejected)
                                {
                                    <div style="color: #ef4444; font-weight: 700; text-align: center; font-size: 0.9rem;">❌ BÁO CÁO BỊ TỪ CHỐI</div>
                                }
                                else
                                {
                                    <div class="progress-track">
                                        <div class="step-dot active"></div>
                                        <div class="step-dot @(isProgress || isResolved ? (isResolved ? "resolved" : "active") : "")"></div>
                                        <div class="step-dot @(isResolved ? "resolved" : "")"></div>
                                    </div>
                                    <div class="step-labels">
                                        <span class="label-active">Đã gửi</span>
                                        <span class="@(isProgress || isResolved ? (isResolved ? "label-resolved" : "label-active") : "")">Đang xử lý</span>
                                        <span class="@(isResolved ? "label-resolved" : "")">Hoàn thành</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>